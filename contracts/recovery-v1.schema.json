{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintai.invalid/contracts/recovery-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "gitops_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scope": {
      "enum": [
        "model",
        "workload"
      ]
    },
    "component": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "gitops_commit",
    "scope"
  ]
}
