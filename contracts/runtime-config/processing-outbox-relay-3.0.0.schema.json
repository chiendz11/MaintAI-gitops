{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintai.invalid/runtime-config/processing-outbox-relay/3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "LOG_LEVEL",
    "ENVIRONMENT",
    "KAFKA_BOOTSTRAP_SERVERS",
    "KAFKA_SECURITY_PROTOCOL",
    "KAFKA_SASL_MECHANISM",
    "KAFKA_SSL_CA_LOCATION",
    "KAFKA_ENABLE_AUTO_COMMIT",
    "RESULT_TOPIC",
    "ALERT_TOPIC",
    "OUTBOX_POLL_INTERVAL_MS",
    "OUTBOX_CLAIM_LEASE_SECONDS",
    "OUTBOX_EXECUTION_MODE",
    "OUTBOX_BATCH_SIZE"
  ],
  "properties": {
    "LOG_LEVEL": {
      "type": "string",
      "minLength": 1
    },
    "ENVIRONMENT": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_BOOTSTRAP_SERVERS": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SECURITY_PROTOCOL": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SASL_MECHANISM": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SSL_CA_LOCATION": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_ENABLE_AUTO_COMMIT": {
      "const": "false"
    },
    "RESULT_TOPIC": {
      "type": "string",
      "minLength": 1
    },
    "ALERT_TOPIC": {
      "type": "string",
      "minLength": 1
    },
    "OUTBOX_POLL_INTERVAL_MS": {
      "type": "string",
      "minLength": 1
    },
    "OUTBOX_CLAIM_LEASE_SECONDS": {
      "type": "string",
      "minLength": 1
    },
    "OUTBOX_EXECUTION_MODE": {
      "const": "ordered"
    },
    "OUTBOX_BATCH_SIZE": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  },
  "description": "PROC-ORDER-01 opt-in configuration. Not active desired state; requires reviewed image/callbacks, DB migration/activation and release-schema receiver cutover."
}
