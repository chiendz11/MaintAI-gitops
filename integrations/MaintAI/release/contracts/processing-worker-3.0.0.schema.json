{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintai.invalid/runtime-config/processing-worker/3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "LOG_LEVEL",
    "ENVIRONMENT",
    "KAFKA_BOOTSTRAP_SERVERS",
    "KAFKA_SECURITY_PROTOCOL",
    "KAFKA_SASL_MECHANISM",
    "KAFKA_SSL_CA_LOCATION",
    "KAFKA_ENABLE_AUTO_COMMIT",
    "KAFKA_GROUP_ID",
    "KAFKA_TOPIC",
    "ML_BASE_URL",
    "MACHINE_REGISTRY_BASE_URL",
    "MODEL_DIR",
    "ML_TIMEOUT_SECONDS",
    "ML_RETRY_LIMIT",
    "PROCESSING_EXECUTION_MODE",
    "PROCESSING_HANDLER_FACTORY",
    "PROCESSING_PREPARE_CALLBACK",
    "PROCESSING_PERSIST_CALLBACK",
    "PROCESSING_MAX_ACTIVE_KEYS",
    "PROCESSING_MAX_PENDING_RECORDS",
    "PROCESSING_MAX_PENDING_BYTES",
    "PROCESSING_MAX_PENDING_PER_KEY",
    "PROCESSING_MAX_UNCOMMITTED_PER_PARTITION",
    "PROCESSING_HANDLER_TIMEOUT_SECONDS",
    "PROCESSING_DRAIN_TIMEOUT_SECONDS",
    "PROCESSING_RESUME_LOW_WATERMARK"
  ],
  "properties": {
    "LOG_LEVEL": {
      "type": "string",
      "minLength": 1
    },
    "ENVIRONMENT": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_BOOTSTRAP_SERVERS": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SECURITY_PROTOCOL": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SASL_MECHANISM": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_SSL_CA_LOCATION": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_ENABLE_AUTO_COMMIT": {
      "const": "false"
    },
    "KAFKA_GROUP_ID": {
      "type": "string",
      "minLength": 1
    },
    "KAFKA_TOPIC": {
      "type": "string",
      "minLength": 1
    },
    "ML_BASE_URL": {
      "type": "string",
      "minLength": 1
    },
    "MACHINE_REGISTRY_BASE_URL": {
      "type": "string",
      "minLength": 1
    },
    "MODEL_DIR": {
      "type": "string",
      "minLength": 1
    },
    "ML_TIMEOUT_SECONDS": {
      "type": "string",
      "minLength": 1
    },
    "ML_RETRY_LIMIT": {
      "type": "string",
      "minLength": 1
    },
    "PROCESSING_EXECUTION_MODE": {
      "const": "keyed"
    },
    "PROCESSING_HANDLER_FACTORY": {
      "const": "maintai_processing.handlers:make_handler"
    },
    "PROCESSING_PREPARE_CALLBACK": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "PROCESSING_PERSIST_CALLBACK": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "PROCESSING_MAX_ACTIVE_KEYS": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "PROCESSING_MAX_PENDING_RECORDS": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "PROCESSING_MAX_PENDING_BYTES": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "PROCESSING_MAX_PENDING_PER_KEY": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "PROCESSING_MAX_UNCOMMITTED_PER_PARTITION": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "PROCESSING_HANDLER_TIMEOUT_SECONDS": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "PROCESSING_DRAIN_TIMEOUT_SECONDS": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$"
    },
    "PROCESSING_RESUME_LOW_WATERMARK": {
      "type": "string",
      "pattern": "^0\\.[0-9]*[1-9][0-9]*$"
    }
  },
  "description": "PROC-ORDER-01 opt-in configuration. Not active desired state; requires reviewed image/callbacks, DB migration/activation and release-schema receiver cutover."
}
