{
  "uid": "maintai-local",
  "title": "MaintAI local \u2014 real exported metrics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Application scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"maintai-apps\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Alert visibility p95 (observed samples)",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(maintai_event_to_alert_visible_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox oldest pending age",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "maintai_outbox_oldest_pending_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Created and grouped alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(maintai_alerts_created_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Drift seconds since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - maintai_drift_worker_last_success_timestamp_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka lag \u2014 requires Kafka exporter",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "refId": "A"
        }
      ]
    }
  ],
  "tags": [
    "maintai",
    "local"
  ]
}
