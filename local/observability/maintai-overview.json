{
  "uid": "maintai-overview",
  "title": "MaintAI — System Overview & Fleet Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["maintai", "fleet", "overview"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application Scrape Health (Online Services)",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(up{job=\"maintai-apps\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 7},
              {"color": "green", "value": 9}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Simulated Active Machines",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "maintai_sensor_active_machines or vector(100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Critical / High Alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(maintai_alerts_created_total{severity=~\"CRITICAL|HIGH\"}) - sum(maintai_alert_transitions_total{to_status=\"RESOLVED\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Live SSE Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "maintai_business_sse_connections or vector(1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telemetry Ingestion Rate (Readings / sec)",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(maintai_ingestion_accepted_total[1m]))",
          "legendFormat": "Accepted Telemetry",
          "refId": "A"
        },
        {
          "expr": "sum(rate(maintai_ingestion_rejected_total[1m]))",
          "legendFormat": "Rejected (DQ Violation)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Committed Alerts by Severity",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(maintai_alerts_created_total[5m])) by (severity)",
          "legendFormat": "Alert {{severity}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(maintai_alerts_deduplicated_total[5m])) by (severity)",
          "legendFormat": "Deduplicated {{severity}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "End-to-End Event to Alert Latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(maintai_event_to_alert_visible_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "E2E Visible p95 (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 3.0}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Service Up Status",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "up{job=\"maintai-apps\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "RAG Service Health & Availability",
      "datasource": {
        "type": "prometheus",
        "uid": "maintai-prometheus"
      },
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "up{job=\"maintai-apps\", service=\"rag-service\"} or vector(1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "READY"}}}
          ]
        }
      }
    }
  ]
}
