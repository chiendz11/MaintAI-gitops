{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::maintai-raw-c8c61d245736",
        "arn:aws:s3:::maintai-processed"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::maintai-raw-c8c61d245736/raw-sensor/*",
        "arn:aws:s3:::maintai-raw-c8c61d245736/raw-catalog/v1/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::maintai-processed/history-exports/*"
      ]
    }
  ]
}
